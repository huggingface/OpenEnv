{
  "$defs": {
    "AgentToolsInterface": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Protocol",
          "type": "string"
        },
        "role": {
          "const": "agent-tools",
          "title": "Role",
          "type": "string"
        },
        "source_revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Source Revision",
          "type": "string"
        },
        "status": {
          "const": "declared",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "role",
        "protocol",
        "status",
        "source_revision"
      ],
      "title": "AgentToolsInterface",
      "type": "object"
    },
    "EnvironmentSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "path": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "provider": {
          "const": "github",
          "title": "Provider",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "uri": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id",
        "uri",
        "revision",
        "path"
      ],
      "title": "EnvironmentSource",
      "type": "object"
    },
    "GitArtifact": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "git",
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Path",
          "type": "string"
        },
        "revision": {
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
          "title": "Revision",
          "type": "string"
        },
        "uri": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "uri",
        "path",
        "revision"
      ],
      "title": "GitArtifact",
      "type": "object"
    },
    "OrchestrationInterface": {
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "openenv",
          "title": "Protocol",
          "type": "string"
        },
        "role": {
          "const": "orchestration",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "protocol"
      ],
      "title": "OrchestrationInterface",
      "type": "object"
    },
    "Owner": {
      "additionalProperties": false,
      "description": "A source-owner declaration, not verification or copyright attribution.",
      "properties": {
        "authority": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Authority",
          "type": "string"
        },
        "id": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "id"
      ],
      "title": "Owner",
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/huggingface/OpenEnv/main/src/openenv/discovery/schemas/0.1-draft/environment-card.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A revision-bound source declaration under the experimental 0.1 profile.",
  "properties": {
    "artifact_availability": {
      "enum": [
        "resolvable",
        "external",
        "unknown"
      ],
      "title": "Artifact Availability",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/GitArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "description": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Description",
      "type": "string"
    },
    "framework_requirement": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Framework Requirement"
    },
    "interfaces": {
      "items": {
        "discriminator": {
          "mapping": {
            "agent-tools": "#/$defs/AgentToolsInterface",
            "orchestration": "#/$defs/OrchestrationInterface"
          },
          "propertyName": "role"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/OrchestrationInterface"
          },
          {
            "$ref": "#/$defs/AgentToolsInterface"
          }
        ]
      },
      "title": "Interfaces",
      "type": "array"
    },
    "license": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "\\S",
      "title": "License",
      "type": "string"
    },
    "license_url": {
      "anyOf": [
        {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Url"
    },
    "manifest_spec_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest Spec Version"
    },
    "name": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Name",
      "type": "string"
    },
    "owner": {
      "anyOf": [
        {
          "$ref": "#/$defs/Owner"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ],
      "title": "Owner"
    },
    "schema_version": {
      "const": "0.1-draft",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/EnvironmentSource"
    }
  },
  "required": [
    "schema_version",
    "name",
    "description",
    "owner",
    "source",
    "artifact_availability",
    "license",
    "interfaces"
  ],
  "title": "EnvironmentCard",
  "type": "object"
}
